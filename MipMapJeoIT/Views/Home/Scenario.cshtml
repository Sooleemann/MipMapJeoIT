@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Home Page";
    Layout = null;
}
<!DOCTYPE html>
<html data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="initial-scale=1, maximum-scale=1, user-scalable=no">
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Özel CSS -->
    <link href="~/css/site.css" asp-append-version="true" rel="stylesheet" />
    <link rel="shortcut icon" href="/favicon.ico">
</head>
<body>
    <div class="container py-4 mt-5">
        <div class="text-center mb-5">
            <h1 class="display-4 text-white">Create Scenario</h1>
            <p class="lead text-white-50">Choose your scenario settings below</p>
        </div>
        <div class="row g-3">
            <!-- Scenario 1 -->
            <div class="col-md-6">
                <div class="card text-white bg-danger">
                    <div class="card-body">
                        <h5 class="card-title">Scenario 1: Scenario1FieldName</h5>
                        <p>Year: <input type="radio" name="year1" checked> 2025</p>
                        <div>
                            <input type="range" class="form-range">
                        </div>
                        <div class="mt-2">
                            <input type="radio" name="scenario1"> Base
                            <input type="radio" name="scenario1"> HP
                            <input type="radio" name="scenario1"> PV
                            <input type="radio" name="scenario1"> Enve
                        </div>
                        <button class="btn btn-light btn-sm mt-2">Create</button>
                    </div>
                </div>
            </div>

            <!-- Scenario 2 -->
            <div class="col-md-6">
                <div class="card text-white bg-primary">
                    <div class="card-body">
                        <h5 class="card-title">Scenario 2: Scenario2FieldName</h5>
                        <p>Year: <input type="radio" name="year2" checked> 2025</p>
                        <div>
                            <input type="range" class="form-range">
                        </div>
                        <div class="mt-2">
                            <input type="radio" name="scenario2"> Base
                            <input type="radio" name="scenario2"> HP
                            <input type="radio" name="scenario2"> PV
                            <input type="radio" name="scenario2"> Enve
                        </div>
                        <button class="btn btn-light btn-sm mt-2">Create</button>
                    </div>
                </div>
            </div>

            <!-- Scenario 3 -->
            <div class="col-md-6">
                <div class="card text-white bg-success">
                    <div class="card-body">
                        <h5 class="card-title">Scenario 3: Scenario3FieldName</h5>
                        <p>Year: <input type="radio" name="year3" checked> 2025</p>
                        <div>
                            <input type="range" class="form-range">
                        </div>
                        <div class="mt-2">
                            <input type="radio" name="scenario3"> Base
                            <input type="radio" name="scenario3"> HP
                            <input type="radio" name="scenario3"> PV
                            <input type="radio" name="scenario3"> Enve
                        </div>
                        <button class="btn btn-light btn-sm mt-2">Create</button>
                    </div>
                </div>
            </div>

            <!-- Scenario 4 -->
            <div class="col-md-6">
                <div class="card text-dark bg-warning">
                    <div class="card-body">
                        <h5 class="card-title">Scenario 4: Scenario4FieldName</h5>
                        <p>Year: <input type="radio" name="year4" checked> 2025</p>
                        <div>
                            <input type="range" class="form-range">
                        </div>
                        <div class="mt-2">
                            <input type="radio" name="scenario4"> Base
                            <input type="radio" name="scenario4"> HP
                            <input type="radio" name="scenario4"> PV
                            <input type="radio" name="scenario4"> Enve
                        </div>
                        <button class="btn btn-dark btn-sm mt-2">Create</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
