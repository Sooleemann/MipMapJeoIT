                            </div>
                        </div>
                    </div>

                    <div id="content2050" class="d-none">
                        <div class="bg-dark text-bg-dark p-3 border rounded mb-2">
                            <div class="form-check mb-2">
                                <label for="sliderQHeating2050" class="form-check-label">F2050 Base QHeating</label>
                            </div>
