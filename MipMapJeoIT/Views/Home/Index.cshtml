@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Home Page";
    Layout = null;
}

<!DOCTYPE html>
<html data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="initial-scale=1, maximum-scale=1, user-scalable=no">
    <title>@ViewData["Title"]</title>

    <link href="~/lib/fontawesome/css/all.min.css" rel="stylesheet" />
    <link href="~/lib/fontawesome/css/solid.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://js.arcgis.com/4.33/esri/themes/dark/main.css" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <link href="~/lib/limonte-sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <script src="~/lib/limonte-sweetalert2/sweetalert2.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.min.js"></script>
    <link href="~/css/site.css" asp-append-version="true" rel="stylesheet" />
    <link rel="shortcut icon" href="/favicon.ico">
    
    <style>

        html, body {
            height: 100%;
        }
     
        #scenarioContainer, #mapContainer {
            min-height: 0;
            min-width: 0;
        }
          
            #scenarioContainer.open {
                width: 900px !important;
            }
        body {
            padding: 0;
            margin: 0;
            height: 100%;

        }

        #toolbarDiv {
            position: absolute;
            top: 0px;
            right: 40px;
            cursor: default;
            display: flex;
            flex-direction: row;
            flex-wrap: nowrap;
        }

        #hover {
            display: none;
            width: 250px;
            background-color: white;
            border: #ccc;
            padding: 0.5rem;
            position: absolute;
            z-index: 1000;
        }

        #drawerFilter {
            top: 20px;
        }

    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-black fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand p-0" href="https://www.mipmap-technologies.com/" target="_blank">
                <img src="~/images/odtu.png" alt="Logo" class="img-fluid" style="max-height:38px;" />
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="true" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNavDropdown">
                <ul class="navbar-nav mx-auto">

                    <li class="nav-item  pe-lg-1">
                        <button type="button" id="btnHome" data-widget="home" data-button="toolbar" class="btn btn-outline-tanap " data-bs-toggle="tooltip" title="Anasayfa">
                            <i class="fas fa-home text-light"></i>
                            <span class="d-inline-block d-lg-none text-light">Home</span>
                        </button>
                    </li>
                    <li class="nav-item  pe-lg-1">
                        <button type="button" id="btnBaseMaps" data-widget="basemaps" data-button="toolbar" class="btn btn-outline-tanap " data-bs-toggle="tooltip" title="Altlýklar">
                            <i class="fab fa-windows text-light"></i>
                            <span class="d-inline-block d-lg-none text-light">Altlık</span>
                        </button>
                    </li>
                    <li class="nav-item  pe-lg-1">
                        <button type="button" id="btnFullScreen" data-widget="fullscreen" data-button="toolbar" class="btn btn-outline-tanap " data-bs-toggle="tooltip" title="Tam Ekran">
                            <i class="fas fa-expand-wide text-light"></i>
                            <span class="d-inline-block d-lg-none text-light">Full Screen</span>
                        </button>
                    </li>
                    <li class="nav-item pe-lg-1">

                        <button type="button" id="btnMeasureLine" data-widget="distance" data-button="toolbar" class="btn btn-outline-tanap" data-bs-toggle="tooltip" title="Uzunluk ölçümü">
                            <i class="fas fa-ruler text-light"></i>
                            <span class="d-inline-block d-lg-none text-light">Mesafe Ölçüm</span>
                        </button>
                    </li>
                    <li class="nav-item  pe-lg-1">
                        <button type="button" id="btnMeasurePoly" data-widget="area" data-button="toolbar" class="btn btn-outline-tanap " data-bs-toggle="tooltip" title="Alan Ölçümü">
                            <i class="fas fa-draw-polygon text-light"></i>
                            <span class="d-inline-block d-lg-none text-light">Alan Ölçüm</span>
                        </button>
                    </li>
                    <li class="nav-item pe-lg-1">
                        <button type="button" id="btnMeasureProfile" data-widget="profile" data-button="toolbar" class="btn btn-outline-tanap " data-bs-toggle="tooltip" title="Yükseklik Profili">
                            <i class="esri-icon-elevation-profile text-light"></i>
                            <span class="d-inline-block d-lg-none text-light">Yükseklik Profili</span>
                        </button>
                    </li>
                    <li class="nav-item pe-lg-1">
                        <button type="button" id="btnLineOfSight" data-widget="lineofsight" data-button="toolbar" class="btn btn-outline-tanap " data-bs-toggle="tooltip" title="Line of Sight">
                            <svg aria-hidden="true" class="svg d-inline" fill="white" height="18" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg"><path d="M8 6h1v1H8zm0 3h1V8H8zm0 2h1v-1H8zm0 2h1v-1H8zm8 2v1H0v-1h6V8H5V7h1V4.572l5-3.57V15zm-6 0V2.944L7 5.087V15zm-6-4.605v-.842A3.373 3.373 0 0 1 .84 7.765a3.37 3.37 0 0 1 1.804-1.234 2.054 2.054 0 0 0-.323 1.073 1.467 1.467 0 0 0 1.6 1.46c.027 0 .053-.005.08-.006v-3.45c-.04 0-.08-.008-.12-.008A5.27 5.27 0 0 0 .066 7.4a.374.374 0 0 0-.032.365A3.893 3.893 0 0 0 4 10.395zM13 7h-1v1h1zm.354-2.288l-.707.707L14.227 7H14v1h.27l-1.623 1.623.707.707L16 7.684v-.325z"></path></svg>

                            <span class="d-inline-block d-lg-none text-light">Line of Sight</span>
                        </button>
                    </li>
                    <li class="nav-item  pe-lg-1">
                        <button type="button" id="btnDaylight" data-widget="daylight" data-button="toolbar" class="btn btn-outline-tanap " data-bs-toggle="tooltip" title="Day Light">
                            <i class="fas fa-sun text-light"></i>
                            <span class="d-inline-block d-lg-none text-light">Day Light</span>
                        </button>
                    </li>
                    <li class="nav-item  pe-lg-1">
                        <button type="button" id="btnSlice" data-widget="slice" data-button="toolbar" class="btn btn-outline-tanap " data-bs-toggle="tooltip" title="Kesme">
                            <i class="fas fa-cut text-light"></i>
                            <span class="d-inline-block d-lg-none text-light">Kesit</span>
                        </button>
                    </li>
                    <li class="nav-item  pe-lg-1">
                        <button type="button" id="btnFeatureTable" data-widget="FeatureTable" data-button="toolbar" class="btn btn-outline-tanap " data-bs-toggle="tooltip" title="Feature Table">
                            <i class="fas fa-table text-light"></i>
                        </button>
                    </li>
                    <li class="nav-item  pe-lg-1">
                        <button type="button" id="btnFiltre" data-widget="filtre" class="btn btn-outline-tanap" data-button="toolbar" data-bs-target="#drawerFilter" data-bs-toggle="offcanvas" title="Filtre Uygula">
                            <i class="far fa-filter text-light"></i>
                            <span class="d-inline-block d-lg-none text-light">Filtre</span>
                        </button>
                    </li>
                    <li class="nav-item pe-lg-1">
                        <button type="button" id="btnScenario" class="btn btn-outline-tanap active">
                            Create Scenario
                        </button>
                    </li>
                </ul>
                <div class="d-flex">
                </div>
            </div>
        </div>
    </nav>

    <!--Filtre popupý-->
    <div class="offcanvas offcanvas-end text-bg-dark offcanvas-transparent" data-bs-backdrop="false" tabindex="-1" id="drawerFilter" aria-labelledby="layerOffcanvasLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="layerOffcanvasLabel">Filtre Uygula</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <ul class="nav nav-tabs mb-4" id="myTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="tab-query" data-bs-toggle="tab" data-bs-target="#tab-query-tab" type="button" role="tab" aria-controls="tab-query-tab" aria-selected="true">Building Features Filter</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-thematic" data-bs-toggle="tab" data-bs-target="#tab-thematic-tab" type="button" role="tab" aria-controls="tab-thematic-tab" aria-selected="false">KPI Filter</button>
                </li>
            </ul>
            <div class="tab-content">
                <div class="tab-pane show active mb-4" id="tab-query-tab" role="tabpanel" aria-labelledby="tab-query-tab" tabindex="0">

                    <div class="bg-dark text-bg-dark p-3 border rounded mb-2">
                        <div class="form-check mb-2">
                            <label for="uwallSlider" class="form-check-label">Uwall</label>
                        </div>
                        <div>
                            <input type="text" class="js-range-slider" min="0" max="2" step="0.0001" id="uwallSlider" />
                        </div>
                    </div>

                    <div class="bg-dark text-bg-dark p-3 border rounded mb-2">
                        <div class="form-check mb-2">
                            <label for="uwindowSlider" class="form-check-label">Uwindow</label>
                        </div>
                        <div>
                            <input type="text" class="js-range-slider" min="0" max="2" step="0.0001" id="uwindowSlider" />
                        </div>
                    </div>

